# Environment: development | production
CAREERPILOT_ENV=development

# HTTP server bind address
CAREERPILOT_HTTP_ADDR=:8080

# PostgreSQL connection string (required in production)
CAREERPILOT_DATABASE_URL=postgres://user:password@localhost:5432/careerpilot?sslmode=disable

# Log level: debug | info | warn | error
CAREERPILOT_LOG_LEVEL=info

# Daily/per-application resource limits (see CLAUDE.md "Initial Resource Limits")
CAREERPILOT_LIMIT_JOBS_DISCOVERED_PER_DAY=100
CAREERPILOT_LIMIT_DEEP_EVALUATIONS_PER_DAY=30
CAREERPILOT_LIMIT_APPLICATIONS_PER_DAY=15
CAREERPILOT_LIMIT_BROWSER_SESSIONS_PER_DAY=10
CAREERPILOT_LIMIT_MAX_RETRIES_PER_APPLICATION=2
CAREERPILOT_LIMIT_MAX_SESSION_MINUTES=30

# Model provider API keys (never commit real values)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
